{
  "name": "lote360-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Studio + Player offline para mapeamento interativo de loteamentos em fotos 360° de drone",
  "author": "raduguem666",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build:player": "vite build --config vite.player.config.js",
    "predev": "npm run build:player",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "prebuild": "npm run build:player",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "electron:build:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.lote360.studio",
    "productName": "Lote360 Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lote360 Studio"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "~0.185.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
